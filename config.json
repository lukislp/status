{
  "site": {
    "title": "lktec status",
    "base_url": "https://status.lktec.org",
    "owner_name": "Lukas Körber",
    "home_url": "https://lktec.org",
    "imprint_url": "https://lktec.org/en/imprint",
    "privacy_url": "https://lktec.org/en/imprint",
    "repo_url": "https://github.com/lukislp/status"
  },
  "settings": {
    "timeout_seconds": 15,
    "retry_delay_seconds": 5,
    "failure_threshold": 2,
    "recovery_threshold": 2,
    "slow_ms": 5000,
    "tls_warn_days": 7,
    "retention_days": 90,
    "publish_interval_minutes": 30
  },
  "issues": {
    "repo": "lukislp/status",
    "authors": ["lukislp"]
  },
  "uptime_resets": ["2026-10-31"],
  "groups": [
    {
      "name": "Website",
      "components": [
        {
          "id": "portfolio",
          "name": "Portfolio (lktec.org)",
          "description": "The personal site at lktec.org, served by Cloudflare Pages.",
          "checks": [
            {
              "name": "Home page",
              "url": "https://lktec.org",
              "expect_body_contains": "Körber"
            }
          ]
        },
        {
          "id": "portfolio-chat",
          "name": "Chat assistant (lktec.org)",
          "description": "The AI chat assistant on lktec.org: its configuration on every run, a real question and answer once a day.",
          "checks": [
            {
              "name": "Health",
              "url": "https://lktec.org/api/chat/health",
              "expect_json": { "ok": true }
            },
            {
              "name": "Answer probe",
              "url": "https://lktec.org/api/chat/probe",
              "method": "POST",
              "headers_from_env": { "X-Status-Probe": "CHAT_PROBE_TOKEN" },
              "interval_minutes": 1440,
              "timeout_seconds": 45,
              "slow_ms": 20000,
              "expect_json": { "ok": true },
              "degraded_json": { "degraded": true },
              "degraded_note": "answered by the fallback model",
              "report_json_fields": ["provider", "degraded", "ttftMs", "latencyMs", "reason"]
            }
          ]
        },
        {
          "id": "links",
          "name": "Links page (links.lktec.org)",
          "description": "The link-in-bio page at links.lktec.org, served by Cloudflare Pages.",
          "checks": [
            {
              "name": "Links page",
              "url": "https://links.lktec.org",
              "expect_body_contains": "Lukas Körber — Links"
            }
          ]
        }
      ]
    },
    {
      "name": "Demos",
      "components": [
        {
          "id": "homelabhub-demo",
          "name": "Homelab Hub demo",
          "description": "Read-only demo of Homelab Hub with sample data.",
          "checks": [
            {
              "name": "Web app",
              "url": "https://homelabhub-demo.lktec.org",
              "expect_body_contains": "HOMELAB//HUB"
            }
          ]
        },
        {
          "id": "piwatch-demo",
          "name": "PiWatch demo",
          "description": "Demo of the PiWatch k3s monitoring dashboard.",
          "checks": [
            {
              "name": "Web app",
              "url": "https://piwatch-demo.lktec.org",
              "expect_body_contains": "PiWatch"
            }
          ]
        },
        {
          "id": "studylife-demo",
          "name": "Studylife demo",
          "description": "Demo of the Studylife web app, including its demo login API.",
          "checks": [
            {
              "name": "Web app",
              "url": "https://studylife-demo.lktec.org",
              "expect_body_contains": "StudyLife"
            },
            {
              "name": "Demo login API",
              "url": "https://studylife-demo.lktec.org/api/auth/demo",
              "expect_json": { "demo": true }
            }
          ]
        },
        {
          "id": "mowdeck-demo",
          "name": "MowDeck demo",
          "description": "Demo of MowDeck, the self-hosted robot mower dashboard.",
          "checks": [
            {
              "name": "Web app",
              "url": "https://mowdeck-demo.lktec.org",
              "expect_header": { "X-MowDeck-Demo": "1" },
              "maintenance_response": {
                "status": 503,
                "header": { "Retry-After": "120" },
                "body_contains": "The MowDeck demo is being reset"
              }
            }
          ]
        }
      ]
    }
  ]
}
